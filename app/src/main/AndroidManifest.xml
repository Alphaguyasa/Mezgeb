<?xml version="1.0" encoding="utf-8"?>
<!--
    Mezgeb main manifest — shared by both distribution flavors.

    Two permission classes must never appear in this file, in any form including
    commented-out text: the restricted messaging-read permissions, and INTERNET.
    Restricted-permission policy covers placeholder and commented declarations, so
    even naming them here would be a violation; the restricted pair is declared
    only in app/src/direct/AndroidManifest.xml. The offline guarantee is likewise a
    product feature, not an oversight. See CONVENTIONS.md hard constraints #1 and #2.

    A shop's ledger must not be auto-backed-up off device, and that takes two
    declarations rather than one: allowBackup="false" governs API 26-30, and from
    Android 12 it is deprecated in favour of dataExtractionRules, which excludes every
    domain from both cloud backup and device-to-device transfer. Either alone leaves
    half the supported range uncovered. See res/xml/data_extraction_rules.xml for why
    device transfer is excluded too, and 03-ARCHITECTURE.md section 8.

    The tools:ignore is narrow and earned. Lint asks for a fullBackupContent resource
    alongside, on the grounds that dataExtractionRules is ignored below Android 12 —
    true, and irrelevant here. Its own explanation says that resource is wanted "if the
    default behavior is not right for your app"; with allowBackup="false" the default
    is exactly right, because no backup runs at all and there is nothing for a rules
    file to select. The check does not read allowBackup. Adding a resource that is
    never consulted would look like diligence and be dead configuration.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The eight vendor system apps that own an "autostart" screen, and nothing else.

        This is a visibility declaration, not a permission: it grants no access to these
        apps, it only lets `resolveActivity` tell us whether a screen exists before we
        try to open it. From API 30 a package an app has not declared is invisible to
        it, so without this block BatteryOptimizationHelper's resolve always returned
        null, the vendor screens were never used, and every device silently fell back to
        the stock battery-optimisation list. Nothing crashed, which is why it went
        unnoticed.

        It is worth being blunt about why a ledger app with no network permission
        enumerates eight package names, because a reviewer will reasonably ask. On
        Xiaomi, Oppo, Vivo, Huawei and Transsion firmware, aggressive battery management
        is the usual reason a notification listener stops being called — which for this
        app means payments quietly stop being captured. The vendor's own autostart
        screen is where that gets fixed, and the stock Android list does not lead there.

        Only queried, never contacted. See VendorBatterySettings for the target table.
    -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.transsion.phonemaster" />
    </queries>

    <!-- The notification listener does not survive a reboot on its own. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        For the reconciliation reminder, and nothing else. Refusing it costs the
        reminder and nothing more: no feature of this app depends on being able to
        interrupt someone.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        WorkManager's own manifest declares ACCESS_NETWORK_STATE so that jobs can
        carry network constraints. Mezgeb has no such job and never will, and an
        app that advertises "it cannot reach the internet" should not be asking
        about the network on the settings screen. Removed at merge time, verified
        by reading the merged manifest.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!--
        Predictive back is opt-in per app. Without it, Android 13+ runs the legacy
        back path and the system's back-preview animation never appears — the gesture
        still works, so the omission is invisible in testing and shows up only as an
        app that feels a version older than the phone it is on.
    -->
    <application
        android:name=".MezgebApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mezgeb">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Mezgeb"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Capture. Exported because the system binds it from another process; the
            signature-level BIND_NOTIFICATION_LISTENER_SERVICE permission is what
            makes that safe, and the binding only happens at all once the user has
            granted notification access in system settings.
        -->
        <service
            android:name=".capture.notification.MezgebNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".capture.boot.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            WorkManager is initialised by the application class instead of by App
            Startup, so that workers can be constructed by Hilt.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
