    <!-- Onboarding -->
    <string name="onboarding_title">መዝገብ ክፍያዎችዎን እንዴት እንደሚያነብ</string>
    <string name="onboarding_intro">የክፍያ መልእክት ሲደርስ — ቴሌብር፣ ሲቢኢ ወይም ባንክዎ — ስልክዎ ማስታወቂያ ያሳያል። መዝገብ ያንን ማስታወቂያ አንብቦ ክፍያውን በመዝገብዎ ውስጥ ይመዘግባል።</string>
    <string name="onboarding_promise_heading">መዝገብ በፍጹም የማያደርገው</string>
    <string name="onboarding_promise_no_payments">ገንዘብ አይልክም፤ አይቀበልም። ማንበብ ብቻ ነው የሚያደርገው።</string>
    <string name="onboarding_promise_offline">ኢንተርኔት አይጠቀምም። የመዘገቡት ነገር ከዚህ ስልክ አይወጣም።</string>
    <string name="onboarding_promise_only_financial">ከባንኮችና ከክፍያ አገልግሎቶች የሚላኩ መልእክቶችን ብቻ ያነባል። የግል መልእክቶች አይነኩም።</string>
    <string name="onboarding_promise_revocable">በማንኛውም ጊዜ ከስልክዎ ቅንብሮች ውስጥ ማጥፋት ይችላሉ።</string>
    <string name="onboarding_access_on">የክፍያ መልእክቶችን ማንበብ በርቷል።</string>
    <string name="onboarding_access_off">የክፍያ መልእክቶችን ማንበብ ጠፍቷል። ክፍያዎች አይመዘገቡም።</string>
    <string name="onboarding_grant_action">የመልእክት ንባብን አብራ</string>
    <string name="onboarding_grant_hint">በሚከፈተው ዝርዝር ውስጥ መዝገብን አግኝተው ያብሩት።</string>

    <!-- Vendor battery optimisation -->
    <string name="onboarding_battery_title">መዝገብ ሳይቋረጥ እንዲሠራ</string>
    <string name="onboarding_battery_body">ስልክዎ ከጀርባ የሚሠሩ መተግበሪያዎችን ሊያቆም ይችላል። ይህ ከሆነ ክፍያዎች መመዝገባቸው ይቆማል፤ የሚነግርዎትም ነገር የለም። መዝገብ እንዲቀጥል ይፍቀዱለት።</string>
    <string name="onboarding_battery_action">የባትሪ ቅንብሮችን ክፈት</string>

