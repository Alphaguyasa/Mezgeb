<?xml version="1.0" encoding="utf-8"?>
<!--
    `direct` flavor manifest — sideloaded distribution only. Never shipped to Play.

    This is the one and only file in the project permitted to declare a restricted
    messaging-read permission. It exists so a shop can backfill the payment history
    already sitting in its inbox, which the notification listener cannot reach
    because it only ever sees messages posted while it is running.

    READ_SMS is used by SmsImportWorker and is requested at runtime before any import
    runs. That is the whole list, deliberately.

    RECEIVE_SMS was declared here through Session 11 because the Session 4 brief asked
    for both. Nothing ever called for it: live capture goes through the notification
    listener in both flavors, so no broadcast receiver was ever registered and the
    permission sat granted-but-unused. Device verification confirmed it — it stayed
    `granted=false` for the whole session while the import worked. A restricted
    permission an app does not use is one it has to justify anyway, to a reviewer or
    to whoever reads the install prompt, and "we asked for it in case" is not a
    justification. Removed rather than carried.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_SMS" />

    <!--
        Declared not-required so the messaging permission above does not silently
        restrict the app to devices with telephony hardware. A tablet with no SIM has
        no inbox to import, but everything else — the notification listener, the
        ledger, credit, reconciliation — works exactly the same.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- The import runs as a foreground service so a long backfill is not killed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Only so the import's progress notification can be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
            From API 34 a foreground service must declare its type. WorkManager owns
            this service; the type is contributed here because only this flavor ever
            runs a foreground worker.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
